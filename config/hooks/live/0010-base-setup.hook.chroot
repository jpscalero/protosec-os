#!/bin/bash
# ============================================================================
# ProtoSec OS 1.0 — Hook 0010: Configuración base del sistema
# ============================================================================
# Este script realiza la configuración fundamental del sistema:
#   - Locales (es_ES.UTF-8)
#   - Zona horaria (Europe/Madrid)
#   - Claves GPG de repositorios externos
#   - Oh-My-Zsh + Starship (prompt)
#   - Fastfetch (información del sistema)
#   - Usuario live 'protosec'
#   - Limpieza final de caché
# ============================================================================

set -e

echo "============================================"
echo " ProtoSec OS 1.0 — Configuración base"
echo "============================================"

# ============================================================================
# PASO 1: Configurar locales en español (es_ES.UTF-8)
# ============================================================================
echo "[1/10] Configurando locales es_ES.UTF-8..."

# Asegurar que el paquete locales está instalado
apt-get install -y --no-install-recommends locales

# Generar el locale español
sed -i 's/# es_ES.UTF-8 UTF-8/es_ES.UTF-8 UTF-8/' /etc/locale.gen
locale-gen es_ES.UTF-8

# Establecer el locale por defecto del sistema
update-locale LANG=es_ES.UTF-8 LC_ALL=es_ES.UTF-8 LANGUAGE=es_ES:es

# Exportar para el resto del script
export LANG=es_ES.UTF-8
export LC_ALL=es_ES.UTF-8

echo "    → Locale es_ES.UTF-8 configurado correctamente."

# ============================================================================
# PASO 2: Configurar zona horaria Europe/Madrid
# ============================================================================
echo "[2/10] Configurando zona horaria Europe/Madrid..."

# Crear enlace simbólico al archivo de zona horaria
ln -sf /usr/share/zoneinfo/Europe/Madrid /etc/localtime

# Escribir la zona en el archivo de configuración
echo "Europe/Madrid" > /etc/timezone

# Reconfigurar el paquete tzdata de forma no interactiva
dpkg-reconfigure -f noninteractive tzdata

echo "    → Zona horaria establecida: $(cat /etc/timezone)"

# ============================================================================
# PASO 3: Descargar e instalar claves GPG de repositorios externos
# ============================================================================
echo "[3/10] Descargando claves GPG de repositorios externos..."

# Crear directorio de keyrings si no existe
mkdir -p /usr/share/keyrings

# --- 3a: Clave GPG de Kali Linux ---
echo "    → Descargando clave GPG de Kali Linux..."
wget -qO- https://archive.kali.org/archive-key.asc \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/kali-archive-keyring.gpg
echo "      ✓ Clave de Kali instalada en /usr/share/keyrings/kali-archive-keyring.gpg"

# Actualizar la referencia en el archivo .list de Kali para usar la clave firmada
# Si el archivo sources.list de Kali no tiene signed-by, añadirlo
if [ -f /etc/apt/sources.list.d/kali.list ]; then
    sed -i 's|^deb http://http.kali.org|deb [signed-by=/usr/share/keyrings/kali-archive-keyring.gpg] http://http.kali.org|' \
        /etc/apt/sources.list.d/kali.list 2>/dev/null || true
fi

# --- 3b: Clave GPG de MongoDB 7.0 ---
echo "    → Descargando clave GPG de MongoDB 7.0..."
curl -fsSL https://www.mongodb.org/static/pgp/server-7.0.asc \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/mongodb-server-7.0.gpg
echo "      ✓ Clave de MongoDB instalada en /usr/share/keyrings/mongodb-server-7.0.gpg"

# --- 3c: Clave GPG de Grafana ---
echo "    → Descargando clave GPG de Grafana..."
curl -fsSL https://apt.grafana.com/gpg.key \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/grafana.gpg
echo "      ✓ Clave de Grafana instalada en /usr/share/keyrings/grafana.gpg"

# --- 3d: Clave GPG de pgAdmin ---
echo "    → Descargando clave GPG de pgAdmin..."
curl -fsSL https://www.pgadmin.org/static/packages_pgadmin_org.pub \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/packages-pgadmin-org.gpg
echo "      ✓ Clave de pgAdmin instalada en /usr/share/keyrings/packages-pgadmin-org.gpg"

# --- 3e: Clave GPG de Elastic (Elasticsearch/Kibana/Logstash) ---
echo "    → Descargando clave GPG de Elastic..."
curl -fsSL https://artifacts.elastic.co/GPG-KEY-elasticsearch \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/elasticsearch-keyring.gpg
echo "      ✓ Clave de Elastic instalada en /usr/share/keyrings/elasticsearch-keyring.gpg"

# --- 3f: Clave GPG de Docker CE ---
echo "    → Descargando clave GPG de Docker CE..."
curl -fsSL https://download.docker.com/linux/debian/gpg \
    | gpg --batch --yes --dearmor -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "      ✓ Clave de Docker instalada en /usr/share/keyrings/docker-archive-keyring.gpg"

# Verificar que todas las claves se han descargado correctamente
echo "    → Verificando claves GPG instaladas..."
for keyring in kali-archive-keyring mongodb-server-7.0 grafana packages-pgadmin-org elasticsearch-keyring docker-archive-keyring; do
    if [ -f "/usr/share/keyrings/${keyring}.gpg" ]; then
        echo "      ✓ ${keyring}.gpg — OK"
    else
        echo "      ✗ ${keyring}.gpg — ERROR: no encontrado"
        exit 1
    fi
done

echo "    → Todas las claves GPG instaladas correctamente."

# ============================================================================
# PASO 4: Actualizar índice de paquetes con los nuevos repositorios
# ============================================================================
echo "[4/10] Actualizando índice de paquetes (apt-get update)..."

# Actualizar la lista de paquetes con todos los repos configurados
# Usamos || true para no fallar si algún repo externo no está disponible temporalmente
apt-get update || true

echo "    → Índice de paquetes actualizado."

# ============================================================================
# PASO 5: Instalar Oh-My-Zsh en /usr/share para todos los usuarios
# ============================================================================
echo "[5/10] Instalando Oh-My-Zsh para todos los usuarios..."

# Asegurar que zsh, git y curl están instalados (necesarios para Oh-My-Zsh)
apt-get install -y --no-install-recommends zsh git curl wget ca-certificates

# Descargar Oh-My-Zsh a una ubicación compartida del sistema
export RUNZSH=no
export CHSH=no
export KEEP_ZSHRC=yes

# Clonar el repositorio de Oh-My-Zsh a /usr/share/oh-my-zsh
if [ ! -d /usr/share/oh-my-zsh ]; then
    git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git /usr/share/oh-my-zsh
    echo "    → Oh-My-Zsh clonado en /usr/share/oh-my-zsh"
else
    echo "    → Oh-My-Zsh ya existe en /usr/share/oh-my-zsh, omitiendo clonación."
fi

# Instalar plugins populares de Oh-My-Zsh
echo "    → Instalando plugins adicionales de zsh..."

# Plugin: zsh-autosuggestions (sugerencias automáticas basadas en historial)
if [ ! -d /usr/share/oh-my-zsh/custom/plugins/zsh-autosuggestions ]; then
    git clone --depth=1 https://github.com/zsh-users/zsh-autosuggestions.git \
        /usr/share/oh-my-zsh/custom/plugins/zsh-autosuggestions
    echo "      ✓ zsh-autosuggestions instalado"
fi

# Plugin: zsh-syntax-highlighting (resaltado de sintaxis en la terminal)
if [ ! -d /usr/share/oh-my-zsh/custom/plugins/zsh-syntax-highlighting ]; then
    git clone --depth=1 https://github.com/zsh-users/zsh-syntax-highlighting.git \
        /usr/share/oh-my-zsh/custom/plugins/zsh-syntax-highlighting
    echo "      ✓ zsh-syntax-highlighting instalado"
fi

# Crear enlace simbólico en /etc/skel para que todos los usuarios tengan Oh-My-Zsh
mkdir -p /etc/skel
ln -sf /usr/share/oh-my-zsh /etc/skel/.oh-my-zsh

# Crear archivo .zshrc por defecto en /etc/skel
cat > /etc/skel/.zshrc << 'ZSHRC_EOF'
# ============================================================================
# ProtoSec OS 1.0 — Configuración de Zsh
# ============================================================================

# Ruta de instalación de Oh-My-Zsh
export ZSH="$HOME/.oh-my-zsh"

# Tema de Oh-My-Zsh (desactivado porque usamos Starship)
ZSH_THEME=""

# Plugins activos de Oh-My-Zsh
plugins=(
    git
    sudo
    docker
    docker-compose
    python
    pip
    nmap
    colored-man-pages
    command-not-found
    zsh-autosuggestions
    zsh-syntax-highlighting
)

# Cargar Oh-My-Zsh
source $ZSH/oh-my-zsh.sh

# --- Variables de entorno ---
export LANG=es_ES.UTF-8
export LC_ALL=es_ES.UTF-8
export EDITOR=nano
export VISUAL=nano

# --- Alias útiles para pentesting ---
alias ll='ls -lah --color=auto'
alias la='ls -A --color=auto'
alias l='ls -CF --color=auto'
alias grep='grep --color=auto'
alias ip='ip -c'
alias ports='ss -tulanp'
alias myip='curl -s ifconfig.me && echo'
alias cls='clear'
alias update='sudo apt update && sudo apt upgrade -y'
alias serve='python3 -m http.server'

# --- Inicializar Starship (prompt personalizado) ---
if command -v starship &> /dev/null; then
    eval "$(starship init zsh)"
fi

# --- Mostrar información del sistema al abrir la terminal ---
if command -v fastfetch &> /dev/null; then
    fastfetch
fi
ZSHRC_EOF

echo "    → Configuración de .zshrc creada en /etc/skel/"

# ============================================================================
# PASO 6: Instalar Starship (prompt personalizado para la terminal)
# ============================================================================
echo "[6/10] Instalando Starship (prompt personalizado)..."

# Descargar e instalar Starship desde el script oficial
curl -sS https://starship.rs/install.sh | sh -s -- -y

# Verificar la instalación
if command -v starship &> /dev/null; then
    echo "    → Starship instalado: $(starship --version | head -1)"
else
    echo "    ⚠ Advertencia: Starship no se pudo instalar. Se continuará sin él."
fi

# Crear configuración personalizada de Starship en /etc/skel
mkdir -p /etc/skel/.config
cat > /etc/skel/.config/starship.toml << 'STARSHIP_EOF'
# ============================================================================
# ProtoSec OS 1.0 — Configuración de Starship
# ============================================================================

# Formato del prompt personalizado
format = """
[┌─ ](bold green)$username$hostname$directory$git_branch$git_status$docker_context$python$rust$golang$nodejs
[└─▶](bold green) """

# Configuración del nombre de usuario
[username]
show_always = true
style_user = "bold green"
style_root = "bold red"
format = "[$user]($style) "

# Configuración del hostname
[hostname]
ssh_only = false
style = "bold #FF6B35"
format = "en [$hostname]($style) "

# Configuración del directorio
[directory]
style = "bold #00FF41"
truncation_length = 5
truncation_symbol = "…/"

# Configuración de Git
[git_branch]
style = "bold #FF6B35"
format = "en [$symbol$branch]($style) "

[git_status]
style = "bold #E0E0E0"

# Configuración de Docker
[docker_context]
style = "bold #00FF41"

# Configuración de Python
[python]
style = "bold yellow"
format = "[$symbol$version]($style) "

# Carácter del prompt
[character]
success_symbol = "[▶](bold green)"
error_symbol = "[▶](bold red)"
STARSHIP_EOF

echo "    → Configuración de Starship creada en /etc/skel/.config/starship.toml"

# ============================================================================
# PASO 7: Instalar fastfetch desde GitHub (última release)
# ============================================================================
echo "[7/10] Instalando fastfetch desde GitHub..."

# Obtener la URL de la última release de fastfetch para linux-amd64
FASTFETCH_URL=$(curl -sL https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest \
    | grep -oP '"browser_download_url":\s*"\K[^"]*linux-amd64\.deb' | head -1)

if [ -n "${FASTFETCH_URL}" ]; then
    echo "    → Descargando fastfetch desde: ${FASTFETCH_URL}"
    wget -q "${FASTFETCH_URL}" -O /tmp/fastfetch.deb

    # Instalar el paquete .deb
    dpkg -i /tmp/fastfetch.deb || apt-get install -f -y
    rm -f /tmp/fastfetch.deb

    echo "    → fastfetch instalado: $(fastfetch --version 2>/dev/null || echo 'versión desconocida')"
else
    echo "    ⚠ No se pudo obtener la URL de fastfetch. Intentando instalación alternativa..."
    # Intentar compilar o usar paquete del repositorio si está disponible
    apt-get install -y fastfetch 2>/dev/null || echo "    ⚠ fastfetch no disponible, se omitirá."
fi

# Crear configuración personalizada de fastfetch en /etc/skel
mkdir -p /etc/skel/.config/fastfetch
cat > /etc/skel/.config/fastfetch/config.jsonc << 'FASTFETCH_EOF'
{
    // ProtoSec OS 1.0 — Configuración de Fastfetch
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "debian",
        "color": {
            "1": "green",
            "2": "white"
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "green",
            "title": "green"
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "de",
        "wm",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "localip",
        "break",
        "colors"
    ]
}
FASTFETCH_EOF

echo "    → Configuración de fastfetch creada en /etc/skel/.config/fastfetch/"

# ============================================================================
# PASO 8: Configurar zsh como shell por defecto del sistema
# ============================================================================
echo "[8/10] Configurando zsh como shell por defecto..."

# Asegurar que zsh está en /etc/shells
if ! grep -q "/bin/zsh" /etc/shells; then
    echo "/bin/zsh" >> /etc/shells
    echo "    → /bin/zsh añadido a /etc/shells"
fi

# Cambiar el shell por defecto de root a zsh
chsh -s /bin/zsh root
echo "    → Shell de root cambiado a /bin/zsh"

# Copiar .zshrc y configuraciones a root también
cp /etc/skel/.zshrc /root/.zshrc
ln -sf /usr/share/oh-my-zsh /root/.oh-my-zsh
mkdir -p /root/.config
cp /etc/skel/.config/starship.toml /root/.config/starship.toml 2>/dev/null || true
cp -r /etc/skel/.config/fastfetch /root/.config/ 2>/dev/null || true

echo "    → Configuraciones de zsh copiadas a /root/"

# ============================================================================
# PASO 9: Crear y configurar el usuario 'protosec'
# ============================================================================
echo "[9/10] Creando usuario 'protosec'..."

# Crear el usuario con los grupos necesarios para pentesting y uso del sistema
# Grupos:
#   sudo       — permisos de administración
#   adm        — acceso a logs del sistema
#   cdrom      — acceso a unidades ópticas
#   audio      — acceso al hardware de audio
#   video      — acceso al hardware de vídeo
#   plugdev    — acceso a dispositivos USB/extraíbles
#   netdev     — gestión de redes
#   bluetooth  — acceso a Bluetooth
#   wireshark  — captura de paquetes de red

# Crear grupo wireshark si no existe (será creado por el paquete, pero por si acaso)
groupadd -f wireshark

# Crear el usuario protosec
if ! id "protosec" &>/dev/null; then
    useradd -m -s /bin/zsh \
        -G sudo,adm,cdrom,audio,video,plugdev,netdev,bluetooth,wireshark \
        -c "ProtoSec OS - Usuario Live" \
        protosec
    echo "    → Usuario 'protosec' creado con los grupos necesarios."
else
    echo "    → El usuario 'protosec' ya existe, actualizando grupos..."
    usermod -aG sudo,adm,cdrom,audio,video,plugdev,netdev,bluetooth,wireshark protosec
fi

# Establecer la contraseña del usuario protosec
echo 'protosec:protosec' | chpasswd
echo "    → Contraseña de 'protosec' establecida."

# Permitir sudo sin contraseña para el usuario protosec (uso live)
echo 'protosec ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/protosec
chmod 0440 /etc/sudoers.d/protosec
echo "    → Sudo sin contraseña configurado para 'protosec'."

# Asegurar que el directorio home tiene las configuraciones de skel
if [ -d /home/protosec ]; then
    # Copiar configuraciones de skel al home del usuario
    cp -rn /etc/skel/. /home/protosec/ 2>/dev/null || true
    chown -R protosec:protosec /home/protosec
    echo "    → Configuraciones de skel copiadas al home de protosec."
fi

# ============================================================================
# PASO 10: Limpieza final de caché de apt
# ============================================================================
echo "[10/10] Limpiando caché de apt..."

# Limpiar paquetes descargados y listas obsoletas
apt-get clean
apt-get autoclean
rm -rf /var/lib/apt/lists/*

# Limpiar archivos temporales generados durante la configuración
rm -rf /tmp/* /var/tmp/*

echo "    → Caché de apt limpiada correctamente."

echo ""
echo "============================================"
echo " ProtoSec OS 1.0 — Configuración base"
echo " completada exitosamente."
echo "============================================"
