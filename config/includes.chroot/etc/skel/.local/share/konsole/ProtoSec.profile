[Appearance]
ColorScheme=ProtoSec
Font=Fira Code,11,-1,5,50,0,0,0,0,0

[General]
Command=/bin/zsh
Name=ProtoSec
Parent=FALLBACK/
TerminalCenter=true
TerminalColumns=120
TerminalRows=35

[Interaction Options]
CopyTextAsHTML=false
TrimLeadingSpacesInSelectedText=true
TrimTrailingSpacesInSelectedText=true

[Scrolling]
HistoryMode=2
ScrollBarPosition=2
